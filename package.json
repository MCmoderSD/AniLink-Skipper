{
  "name": "anilink-skipper",
  "version": "1.1.0",
  "description": "A Chrome extension to skip the ouo.io redirect on anime-loads.org by injecting a cookie.",
  "license": "BSD-3-Clause",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/chrome": "^0.2.6",
    "typescript": "^7.0.2"
  }
}